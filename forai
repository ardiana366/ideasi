<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wiremap Studio - App Layout & Flow</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .canvas-grid {
      background-color: #0f172a;
      background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 20px 20px;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 h-screen w-screen flex flex-col overflow-hidden">

  <!-- Header Nav / Toolbar -->
  <header class="h-14 bg-slate-900/80 backdrop-blur-md border-b border-slate-800/80 px-4 flex items-center justify-between z-30">
    <div class="flex items-center gap-3">
      <div class="h-8 w-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-sky-400 flex items-center justify-center text-white font-bold text-xs shadow-md shadow-indigo-500/20">
        WM
      </div>
      <div>
        <h1 class="text-xs font-semibold text-white tracking-tight leading-none">Wiremap Layout Studio</h1>
        <p class="text-[10px] text-slate-400 mt-0.5">UI Page Architecture & AI-Enriched Schema Engine</p>
      </div>
    </div>

    <!-- Mode and Controls -->
    <div class="flex items-center gap-2">
      <!-- Mode Toggle -->
      <div class="flex bg-slate-800/90 p-0.5 rounded-lg border border-slate-700/60 text-xs">
        <button id="selectModeBtn" class="px-3 py-1 rounded-md bg-indigo-600 text-white font-medium shadow-sm transition">
          Select / Move
        </button>
        <button id="arrowModeBtn" class="px-3 py-1 rounded-md text-slate-300 hover:text-white transition flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          Connect Step
        </button>
      </div>

      <div class="h-4 w-px bg-slate-800 mx-1"></div>

      <!-- Delete Button -->
      <button id="deleteBtn" class="px-2.5 py-1.5 text-xs font-medium border border-rose-900/50 hover:border-rose-700 bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 rounded-lg transition flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Delete
      </button>

      <div class="h-4 w-px bg-slate-800 mx-1"></div>

      <!-- Presets -->
      <div class="flex bg-slate-800/60 p-0.5 rounded-lg border border-slate-700/60 text-xs">
        <button id="presetDesktop" class="px-2 py-1 rounded text-slate-300 hover:text-white transition">Desktop</button>
        <button id="presetMobile" class="px-2 py-1 rounded text-slate-300 hover:text-white transition">Mobile</button>
      </div>

      <div class="h-4 w-px bg-slate-800 mx-1"></div>

      <!-- Import / Export -->
      <label class="px-2.5 py-1.5 text-xs font-medium border border-slate-700 hover:border-slate-600 bg-slate-800/50 hover:bg-slate-800 text-slate-300 rounded-lg cursor-pointer transition flex items-center gap-1.5">
        Import JSON
        <input type="file" id="importJsonInput" class="hidden" accept=".json" />
      </label>

      <button id="exportJsonBtn" class="px-2.5 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition flex items-center gap-1.5 shadow-sm">
        Export JSON (AI Context)
      </button>
    </div>
  </header>

  <div class="flex-1 flex overflow-hidden relative">
    <!-- Component Palette Sidebar -->
    <aside class="w-64 bg-slate-900/60 backdrop-blur-md border-r border-slate-800/80 p-3 flex flex-col gap-4 z-20 overflow-y-auto">
      <div>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-1">Layout Frames</span>
        <div class="grid grid-cols-2 gap-1.5 mt-2">
          <button onclick="addWireframeItem('frame')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-left text-xs hover:border-indigo-500/50 transition">
            <span class="block font-medium text-slate-200">Frame Box</span>
            <span class="text-[10px] text-slate-400">Page container</span>
          </button>
          <button onclick="addWireframeItem('card')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-left text-xs hover:border-indigo-500/50 transition">
            <span class="block font-medium text-slate-200">Card Panel</span>
            <span class="text-[10px] text-slate-400">Component box</span>
          </button>
        </div>
      </div>

      <div>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-1">UI Controls</span>
        <div class="flex flex-col gap-1.5 mt-2">
          <button onclick="addWireframeItem('button')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-left text-xs hover:border-indigo-500/50 transition flex justify-between items-center">
            <span class="text-slate-200">Button / CTA</span>
            <span class="text-[10px] bg-slate-700 text-slate-300 px-1.5 py-0.5 rounded">Action</span>
          </button>
          <button onclick="addWireframeItem('input')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-left text-xs hover:border-indigo-500/50 transition flex justify-between items-center">
            <span class="text-slate-200">Text Input</span>
            <span class="text-[10px] bg-slate-700 text-slate-300 px-1.5 py-0.5 rounded">Field</span>
          </button>
          <button onclick="addWireframeItem('dropdown')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-left text-xs hover:border-indigo-500/50 transition flex justify-between items-center">
            <span class="text-slate-200">Dropdown Selector</span>
            <span class="text-[10px] bg-slate-700 text-slate-300 px-1.5 py-0.5 rounded">Select</span>
          </button>
          <button onclick="addWireframeItem('table')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-left text-xs hover:border-indigo-500/50 transition flex justify-between items-center">
            <span class="text-slate-200">Data Grid / Table</span>
            <span class="text-[10px] bg-slate-700 text-slate-300 px-1.5 py-0.5 rounded">Data</span>
          </button>
        </div>
      </div>

      <div>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-1">Markers & Shapes</span>
        <div class="grid grid-cols-2 gap-1.5 mt-2">
          <button onclick="addWireframeItem('circle')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-xs text-center text-slate-200 hover:border-indigo-500/50 transition">Circle</button>
          <button onclick="addWireframeItem('badge')" class="p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-xs text-center text-slate-200 hover:border-indigo-500/50 transition">Pill / Tag</button>
        </div>
      </div>

      <div class="mt-auto p-2.5 rounded-xl bg-slate-800/40 border border-slate-800 text-[11px] text-slate-400 space-y-1">
        <p class="font-medium text-slate-300">Semantic AI Rules:</p>
        <p>• <b>Kiri $\leftrightarrow$ Kanan:</b> Relasi alur / sumber data[span_1](start_span)[span_1](end_span)</p>
        <p>• <b>Atas $\leftrightarrow$ Bawah:</b> Komponen anak / detail[span_2](start_span)[span_2](end_span)</p>
        <p>• <b>Double click:</b> Ubah teks elemen</p>
      </div>
    </aside>

    <!-- Workspace -->
    <main class="flex-1 relative overflow-hidden canvas-grid" id="workspace">
      <canvas id="wiremapCanvas" class="w-full h-full block"></canvas>
    </main>
  </div>

  <script>
    const canvas = document.getElementById('wiremapCanvas');
    const ctx = canvas.getContext('2d');

    let state = {
      items: [],
      connections: [],
      selectedId: null,
      selectedConnId: null,
      mode: 'select', // 'select' | 'arrow'
      connectSourceId: null,
      resizing: false,
      camera: { x: 280, y: 120, zoom: 0.9 },
      drag: { isDragging: false, targetItem: null, lastMouse: { x: 0, y: 0 } }
    };

    // Initial Layout Blueprint Seed
    state.items = [
      { id: 'f_auth', type: 'frame', text: 'Step 1: Auth View', x: 80, y: 80, w: 320, h: 420 },
      { id: 'i_user', type: 'input', text: 'Username Field', x: 120, y: 160, w: 240, h: 36 },
      { id: 'i_pass', type: 'input', text: 'Password Field', x: 120, y: 220, w: 240, h: 36 },
      { id: 'b_login', type: 'button', text: 'Submit Login', x: 120, y: 290, w: 240, h: 40 },

      { id: 'f_dash', type: 'frame', text: 'Step 2: Dashboard Overview', x: 520, y: 80, w: 560, h: 420 },
      { id: 't_data', type: 'table', text: 'Dynamic Analytics Table', x: 560, y: 160, w: 480, h: 240 },
      { id: 'd_filter', type: 'dropdown', text: 'Status Filter', x: 560, y: 420, w: 200, h: 36 }
    ];

    state.connections = [
      { id: 'c_auth_to_dash', from: 'b_login', to: 'f_dash', fromSide: 'right', toSide: 'left' },
      { id: 'c_table_to_filter', from: 't_data', to: 'd_filter', fromSide: 'bottom', toSide: 'top' }
    ];

    function resizeCanvas() {
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;
      draw();
    }
    window.addEventListener('resize', resizeCanvas);

    function addWireframeItem(type) {
      const center = screenToWorld(canvas.width / 2, canvas.height / 2);
      const id = `node_${Date.now()}`;
      let item = { id, type, text: type.toUpperCase(), x: center.x, y: center.y, w: 160, h: 44 };

      if (type === 'frame') { item.w = 440; item.h = 360; item.text = 'View Container'; }
      else if (type === 'card') { item.w = 240; item.h = 160; item.text = 'Card Section'; }
      else if (type === 'table') { item.w = 340; item.h = 200; item.text = 'Table Grid'; }
      else if (type === 'circle') { item.w = 54; item.h = 54; item.text = 'Avatar'; }
      else if (type === 'badge') { item.w = 90; item.h = 30; item.text = 'Badge'; }

      state.items.push(item);
      state.selectedId = id;
      state.selectedConnId = null;
      draw();
    }

    function deleteSelected() {
      if (state.selectedId) {
        state.items = state.items.filter(i => i.id !== state.selectedId);
        state.connections = state.connections.filter(c => c.from !== state.selectedId && c.to !== state.selectedId);
        state.selectedId = null;
      } else if (state.selectedConnId) {
        state.connections = state.connections.filter(c => c.id !== state.selectedConnId);
        state.selectedConnId = null;
      }
      draw();
    }

    function getItemCenter(item) {
      return { x: item.x + item.w / 2, y: item.y + item.h / 2 };
    }

    function calculateAnchorPoints(fromItem, toItem) {
      const c1 = getItemCenter(fromItem);
      const c2 = getItemCenter(toItem);
      const dx = c2.x - c1.x;
      const dy = c2.y - c1.y;

      let fromSide = 'right', toSide = 'left';
      let p1 = { x: fromItem.x + fromItem.w, y: c1.y };
      let p2 = { x: toItem.x, y: c2.y };

      if (Math.abs(dx) >= Math.abs(dy)) {
        // Horizontal orientation
        if (dx < 0) {
          fromSide = 'left'; toSide = 'right';
          p1 = { x: fromItem.x, y: c1.y };
          p2 = { x: toItem.x + toItem.w, y: c2.y };
        }
      } else {
        // Vertical orientation
        if (dy >= 0) {
          fromSide = 'bottom'; toSide = 'top';
          p1 = { x: c1.x, y: fromItem.y + fromItem.h };
          p2 = { x: c2.x, y: toItem.y };
        } else {
          fromSide = 'top'; toSide = 'bottom';
          p1 = { x: c1.x, y: fromItem.y };
          p2 = { x: c2.x, y: toItem.y + toItem.h };
        }
      }

      return { p1, p2, fromSide, toSide };
    }

    function drawArrowHead(ctx, fromX, fromY, toX, toY, size = 9) {
      const angle = Math.atan2(toY - fromY, toX - fromX);
      ctx.beginPath();
      ctx.moveTo(toX, toY);
      ctx.lineTo(toX - size * Math.cos(angle - Math.PI / 6), toY - size * Math.sin(angle - Math.PI / 6));
      ctx.lineTo(toX - size * Math.cos(angle + Math.PI / 6), toY - size * Math.sin(angle + Math.PI / 6));
      ctx.closePath();
      ctx.fill();
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      ctx.save();
      ctx.translate(state.camera.x, state.camera.y);
      ctx.scale(state.camera.zoom, state.camera.zoom);

      // 1. Draw Next-Step Connection Arrows
      state.connections.forEach(conn => {
        const fromItem = state.items.find(i => i.id === conn.from);
        const toItem = state.items.find(i => i.id === conn.to);
        if (!fromItem || !toItem) return;

        const { p1, p2, fromSide, toSide } = calculateAnchorPoints(fromItem, toItem);
        conn.fromSide = fromSide;
        conn.toSide = toSide;

        const isConnSelected = conn.id === state.selectedConnId;
        const dx = (p2.x - p1.x) * 0.45;
        const dy = (p2.y - p1.y) * 0.45;

        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.bezierCurveTo(p1.x + dx, p1.y + (Math.abs(dx) < Math.abs(dy) ? dy : 0), 
                          p2.x - dx, p2.y - (Math.abs(dx) < Math.abs(dy) ? dy : 0), 
                          p2.x, p2.y);
        ctx.strokeStyle = isConnSelected ? '#38bdf8' : '#6366f1';
        ctx.lineWidth = isConnSelected ? 3 : 2;
        ctx.stroke();

        ctx.fillStyle = isConnSelected ? '#38bdf8' : '#6366f1';
        drawArrowHead(ctx, p2.x - (p2.x - p1.x) * 0.1, p2.y - (p2.y - p1.y) * 0.1, p2.x, p2.y);
      });

      // 2. Draw Elements
      state.items.forEach(item => {
        const isSelected = item.id === state.selectedId;
        const isConnectSource = item.id === state.connectSourceId;

        ctx.save();
        ctx.translate(item.x, item.y);

        if (item.type === 'frame') {
          ctx.fillStyle = 'rgba(15, 23, 42, 0.75)';
          ctx.strokeStyle = isSelected ? '#6366f1' : '#334155';
          ctx.lineWidth = isSelected ? 2 : 1.5;
          ctx.beginPath();
          ctx.roundRect(0, 0, item.w, item.h, 12);
          ctx.fill();
          ctx.stroke();

          // Title bar
          ctx.fillStyle = '#1e293b';
          ctx.beginPath();
          ctx.roundRect(0, 0, item.w, 32, [12, 12, 0, 0]);
          ctx.fill();

          // Traffic light dots
          ctx.fillStyle = '#ef4444'; ctx.beginPath(); ctx.arc(14, 16, 4, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#f59e0b'; ctx.beginPath(); ctx.arc(26, 16, 4, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#10b981'; ctx.beginPath(); ctx.arc(38, 16, 4, 0, Math.PI * 2); ctx.fill();

          ctx.fillStyle = '#94a3b8';
          ctx.font = '500 11px sans-serif';
          ctx.fillText(item.text, 52, 20);

        } else if (item.type === 'card') {
          ctx.fillStyle = '#1e293b';
          ctx.strokeStyle = isSelected ? '#6366f1' : '#475569';
          ctx.lineWidth = isSelected ? 2 : 1;
          ctx.beginPath();
          ctx.roundRect(0, 0, item.w, item.h, 8);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#cbd5e1';
          ctx.font = '600 12px sans-serif';
          ctx.fillText(item.text, 12, 22);

        } else if (item.type === 'button') {
          ctx.fillStyle = '#4f46e5';
          ctx.strokeStyle = isSelected ? '#ffffff' : '#6366f1';
          ctx.lineWidth = isSelected ? 2 : 1;
          ctx.beginPath();
          ctx.roundRect(0, 0, item.w, item.h, 6);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#ffffff';
          ctx.font = '500 12px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(item.text, item.w / 2, item.h / 2 + 4);
          ctx.textAlign = 'left';

        } else if (item.type === 'input') {
          ctx.fillStyle = '#0f172a';
          ctx.strokeStyle = isSelected ? '#6366f1' : '#475569';
          ctx.lineWidth = isSelected ? 2 : 1;
          ctx.beginPath();
          ctx.roundRect(0, 0, item.w, item.h, 6);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#64748b';
          ctx.font = '12px sans-serif';
          ctx.fillText(item.text, 10, item.h / 2 + 4);

        } else if (item.type === 'table') {
          ctx.fillStyle = '#1e293b';
          ctx.strokeStyle = isSelected ? '#6366f1' : '#334155';
          ctx.beginPath();
          ctx.roundRect(0, 0, item.w, item.h, 6);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#334155';
          ctx.fillRect(0, 0, item.w, 28);
          ctx.fillStyle = '#e2e8f0';
          ctx.font = '600 11px sans-serif';
          ctx.fillText(item.text, 10, 18);

          ctx.strokeStyle = '#334155';
          for (let y = 56; y < item.h; y += 28) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(item.w, y);
            ctx.stroke();
          }

        } else if (item.type === 'circle') {
          ctx.fillStyle = '#334155';
          ctx.strokeStyle = isSelected ? '#6366f1' : '#64748b';
          ctx.beginPath();
          ctx.arc(item.w / 2, item.h / 2, Math.min(item.w, item.h) / 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        } else {
          ctx.fillStyle = '#1e293b';
          ctx.strokeStyle = isSelected ? '#6366f1' : '#475569';
          ctx.beginPath();
          ctx.roundRect(0, 0, item.w, item.h, 6);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = '#e2e8f0';
          ctx.font = '11px sans-serif';
          ctx.fillText(item.text, 10, item.h / 2 + 4);
        }

        // Connection Mode Source Highlight
        if (isConnectSource) {
          ctx.strokeStyle = '#38bdf8';
          ctx.lineWidth = 2;
          ctx.setLineDash([4, 4]);
          ctx.strokeRect(-4, -4, item.w + 8, item.h + 8);
          ctx.setLineDash([]);
        }

        // Resize Handle
        if (isSelected && state.mode === 'select') {
          ctx.fillStyle = '#6366f1';
          ctx.fillRect(item.w - 8, item.h - 8, 8, 8);
        }

        ctx.restore();
      });

      ctx.restore();
    }

    function screenToWorld(x, y) {
      return {
        x: (x - state.camera.x) / state.camera.zoom,
        y: (y - state.camera.y) / state.camera.zoom
      };
    }

    function getItemAt(wx, wy) {
      for (let i = state.items.length - 1; i >= 0; i--) {
        const item = state.items[i];
        if (wx >= item.x && wx <= item.x + item.w && wy >= item.y && wy <= item.y + item.h) {
          return item;
        }
      }
      return null;
    }

    // Pointer Interaction Handlers
    canvas.addEventListener('mousedown', (e) => {
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      const world = screenToWorld(mouseX, mouseY);
      const clicked = getItemAt(world.x, world.y);

      if (state.mode === 'arrow') {
        if (clicked) {
          if (!state.connectSourceId) {
            state.connectSourceId = clicked.id;
          } else if (state.connectSourceId !== clicked.id) {
            state.connections.push({
              id: `conn_${Date.now()}`,
              from: state.connectSourceId,
              to: clicked.id
            });
            state.connectSourceId = null;
          }
        } else {
          state.connectSourceId = null;
        }
        draw();
        return;
      }

      state.drag.isDragging = true;
      state.drag.lastMouse = { x: mouseX, y: mouseY };

      if (clicked) {
        state.selectedId = clicked.id;
        state.selectedConnId = null;
        state.drag.targetItem = clicked;

        if (world.x >= clicked.x + clicked.w - 12 && world.y >= clicked.y + clicked.h - 12) {
          state.resizing = true;
        } else {
          state.resizing = false;
        }
      } else {
        state.selectedId = null;
        state.drag.targetItem = null;
        state.resizing = false;
      }
      draw();
    });

    window.addEventListener('mousemove', (e) => {
      if (!state.drag.isDragging) return;
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      const dx = (mouseX - state.drag.lastMouse.x) / state.camera.zoom;
      const dy = (mouseY - state.drag.lastMouse.y) / state.camera.zoom;

      if (state.drag.targetItem) {
        if (state.resizing) {
          state.drag.targetItem.w = Math.max(30, state.drag.targetItem.w + dx);
          state.drag.targetItem.h = Math.max(20, state.drag.targetItem.h + dy);
        } else {
          state.drag.targetItem.x += dx;
          state.drag.targetItem.y += dy;
        }
      } else {
        state.camera.x += mouseX - state.drag.lastMouse.x;
        state.camera.y += mouseY - state.drag.lastMouse.y;
      }

      state.drag.lastMouse = { x: mouseX, y: mouseY };
      draw();
    });

    window.addEventListener('mouseup', () => {
      state.drag.isDragging = false;
      state.resizing = false;
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Delete' || e.key === 'Backspace') {
        if (document.activeElement.tagName !== 'INPUT') {
          deleteSelected();
        }
      }
    });

    canvas.addEventListener('dblclick', (e) => {
      const rect = canvas.getBoundingClientRect();
      const world = screenToWorld(e.clientX - rect.left, e.clientY - rect.top);
      const clicked = getItemAt(world.x, world.y);
      if (clicked) {
        const val = prompt('Edit Element Label:', clicked.text);
        if (val !== null) {
          clicked.text = val;
          draw();
        }
      }
    });

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;
      const newZoom = Math.min(Math.max(state.camera.zoom * zoomFactor, 0.2), 2.5);

      state.camera.x = mouseX - (mouseX - state.camera.x) * (newZoom / state.camera.zoom);
      state.camera.y = mouseY - (mouseY - state.camera.y) * (newZoom / state.camera.zoom);
      state.camera.zoom = newZoom;
      draw();
    }, { passive: false });

    // Mode Switches
    const selectModeBtn = document.getElementById('selectModeBtn');
    const arrowModeBtn = document.getElementById('arrowModeBtn');

    selectModeBtn.addEventListener('click', () => {
      state.mode = 'select';
      state.connectSourceId = null;
      selectModeBtn.className = 'px-3 py-1 rounded-md bg-indigo-600 text-white font-medium shadow-sm transition';
      arrowModeBtn.className = 'px-3 py-1 rounded-md text-slate-300 hover:text-white transition flex items-center gap-1';
      draw();
    });

    arrowModeBtn.addEventListener('click', () => {
      state.mode = 'arrow';
      state.selectedId = null;
      arrowModeBtn.className = 'px-3 py-1 rounded-md bg-indigo-600 text-white font-medium shadow-sm transition flex items-center gap-1';
      selectModeBtn.className = 'px-3 py-1 rounded-md text-slate-300 hover:text-white transition';
      draw();
    });

    document.getElementById('deleteBtn').addEventListener('click', deleteSelected);

    document.getElementById('presetDesktop').addEventListener('click', () => {
      const frame = state.items.find(i => i.type === 'frame');
      if (frame) { frame.w = 1200; frame.h = 800; draw(); }
    });

    document.getElementById('presetMobile').addEventListener('click', () => {
      const frame = state.items.find(i => i.type === 'frame');
      if (frame) { frame.w = 390; frame.h = 844; draw(); }
    });

    // AI-Enriched Export JSON
    document.getElementById('exportJsonBtn').addEventListener('click', () => {
      const enrichedConnections = state.connections.map(conn => {
        const fromItem = state.items.find(i => i.id === conn.from);
        const toItem = state.items.find(i => i.id === conn.to);
        const isHorizontal = (conn.fromSide === 'left' && conn.toSide === 'right') || 
                             (conn.fromSide === 'right' && conn.toSide === 'left');

        return {
          id: conn.id,
          from: conn.from,
          to: conn.to,
          fromSide: conn.fromSide,
          toSide: conn.toSide,
          relationType: isHorizontal ? "FLOW_RELATION_SOURCE" : "HIERARCHICAL_CHILD_DETAIL",
          semanticDescription: isHorizontal 
            ? `Relasi fungsional/alur sumber: '${fromItem ? fromItem.text : conn.from}' bermuara ke '${toItem ? toItem.text : conn.to}'`
            : `Relasi hierarki: '${toItem ? toItem.text : conn.to}' adalah child atau detail komponen dari '${fromItem ? fromItem.text : conn.from}'`
        };
      });

      const payload = {
        version: 1,
        exportedAt: new Date().toISOString(),
        _ai_context_guide: {
          app_type: "Wiremap UI Page Layout & Flow Engine",
          parsing_instructions: [
            "Garis horizontal (kiri <-> kanan): Menandakan relasi / sumber data, event trigger, atau alur navigasi antar layar.",
            "Garis vertikal (atas <-> bawah): Menandakan hierarki child, sub-komponen, atau keterangan detail elemen.",
            "Items dengan type 'frame' adalah layar/kontainer utama (viewport), sedangkan 'card', 'button', 'table', 'input' adalah elemen UI di dalamnya."
          ],
          axis_semantics: {
            horizontal_line: "relasi / sumber",
            vertical_line: "child / keterangan"
          }
        },
        items: state.items.map(item => ({
          ...item,
          hierarchyRole: item.type === 'frame' ? 'PAGE_VIEWPORT' : (item.type === 'card' ? 'CONTAINER_SECTION' : 'UI_COMPONENT')
        })),
        connections: enrichedConnections
      };

      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `wiremap_layout_${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // Import JSON
    document.getElementById('importJsonInput').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const data = JSON.parse(event.target.result);
          if (data.items) state.items = data.items;
          if (data.connections) state.connections = data.connections;
          draw();
        } catch(err) {
          alert('Invalid layout JSON file');
        }
      };
      reader.readAsText(file);
      e.target.value = '';
    });

    resizeCanvas();
  </script>
</body>
</html>
